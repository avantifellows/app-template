# Every variable the app reads. Copy to .env.local for local work; never commit real values.
# On Amplify an approver (Pritam, Deepansh or Surya) sets the real values; scripts/write-env.mjs copies
# the ones listed here into the server at build time.

# Long random string: openssl rand -hex 32
AUTH_SECRET=
# This app's own OAuth client, in Google Cloud project af-internal-apps (an approver creates it).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# The site's real address, e.g. https://myapp.avantifellows.org (local: http://localhost:3000).
# Wrong or missing, Google sign-in sends people back to localhost.
AUTH_URL=
AUTH_TRUST_HOST=true

# Optional. Read-only Postgres credentials from a dev, e.g. postgres://user:pass@host:5432/db?sslmode=require
DATA_DATABASE_URL=

# Local only: "true" adds a test login so you can work without Google. Production builds ignore it.
ENABLE_TEST_LOGIN=
